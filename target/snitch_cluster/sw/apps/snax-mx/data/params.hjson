{
    K: 1024
    N: 32
    M: 32
    parfor_M: 4
    parfor_N: 16
    parfor_K: 4
    block_size: 16
    A_dtype: "fp8_e5m2"
    B_dtype: "fp8_e5m2"
    quantize_mode: 2
    shared_format: 4
